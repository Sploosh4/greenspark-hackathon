  "retained_demo_integrity": "Keep current exact hashes and row-count verification enabled for preloaded demo",
  "uploaded_batch_policy": "Use server-owned schema allowlist; measure each new batch own hashes, counts and coverage. Do not require demo hashes or counts and do not trust an uploaded manifest.",
  "existing_checks": [
    "exact ordered headers",
    "required primary keys nonblank and unique",
    "all customer foreign keys resolve",
    "consumption/prepay numbers present, finite and nonnegative",
    "connected or disconnected_non_payment supply status",
    "outage_hours within 0..24",
    "import components reconcile to import_kwh within0.0031",
    "prepay credit and unfunded-cost reconciliation within0.021",
    "canonical ISO date fields when supplied",
    "account closure does not precede opening",
    "retained Fitzroy support-arrangement parent/customer links resolve"
  ],
  "additional_upload_requirements": [
    "complete file set; reject missing or duplicate filenames",
    "reject unknown filename, path components and unsupported compression",
    "bounded bytes and decoded size; valid gzip CRC, UTF-8 and CSV structure",
    "validate prepay_topups.datetime explicitly; current generic date check does not inspect it",
    "check declared source boolean/domain fields without coercing blanks to false",
    "validate date/interval ordering where source semantics establish it; effective_to is exclusive",
    "validate parent-record references across the submitted batch before locality selection",
    "measure partial usage coverage as warning/no-estimate reason, never zero-fill",
    "preserve optional financial blanks and no-record states",
    "future business rows may be retained but must remain excluded by unchanged review cutoff",
    "run unchanged review calculation and verify output before activation"
  ],
  "prohibited_inference": [
    "opening_balance and is_opening_debt are not money amounts",
    "payments have no bill-allocation foreign key",
    "an application/assessment does not establish delivered assistance",
    "timely payment under an extension does not erase assistance",
    "source dates do not establish availability timestamps or a timezone"
  ],
  "activation": "One complete validated snapshot and its derived review become active together; failure before activation leaves last-good unchanged",
  "implementation": {
    "validation": "prototype/uploads.py",
    "transport": "serve.py",
    "limits_mib": {
      "body": 64,
      "file": 32,
      "decoded_file": 128,
      "decoded_batch": 256
    },
    "max_rows_per_file": 1000000,
    "credentials": "none persistent; ephemeral same-origin request protection only"
  }
}
