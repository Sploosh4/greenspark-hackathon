FROM python:3.12.16-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/tmp OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
WORKDIR /app
COPY requirements-q1-current.txt /opt/runtime/requirements.txt
COPY wheels/ /opt/wheels/
RUN python -m pip install --no-cache-dir --no-compile --no-index --only-binary=:all: --no-deps --require-hashes -r /opt/runtime/requirements.txt && rm -r /opt/wheels
COPY font/DejaVuSans.ttf /usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
COPY font/LICENSE /usr/share/doc/team-connect-font/LICENSE
COPY app/ /app/
COPY runtime/ /opt/runtime/
RUN mkdir -p /state/uploads && chown -R 10001:10001 /state && chmod 700 /state /state/uploads && mkdir /identity && chown 10001:10001 /identity && chmod 700 /identity
USER 10001:10001
EXPOSE 8891
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 CMD ["python", "/opt/runtime/healthcheck.py", "8891", "q1"]
CMD ["python", "/opt/runtime/q1_launcher.py", "--app-root", "/app", "--source-root", "/inputs/q1", "--runtime-dir", "/state/uploads", "--listen", "0.0.0.0", "--port", "8891"]
