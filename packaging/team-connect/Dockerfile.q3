FROM python:3.13.18-slim-bookworm@sha256:281d39ff02e3b389401586134ff9e6572954687822a58055ec07a60ded4e0b7f
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/tmp
WORKDIR /app
COPY app/ /app/
COPY runtime/ /opt/runtime/
RUN mkdir -p /state && chown 10002:10002 /state && chmod 700 /state && mkdir /identity && chown 10002:10002 /identity && chmod 700 /identity
USER 10002:10002
EXPOSE 8797
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD ["python", "/opt/runtime/healthcheck.py", "8797", "q3"]
CMD ["python", "/opt/runtime/q3_launcher.py", "--app-root", "/app", "--inputs-dir", "/app/data/inputs", "--runtime-dir", "/state", "--maptiler-env", "/run/secrets/maptiler_env", "--listen", "0.0.0.0", "--port", "8797"]
